@using System.Globalization
@model EWallet.Mvc.ViewModel.TransferViewModel

@{
    ViewData["Title"] = "Transfer";

    var user = ViewBag.User as EWallet.Core.Models.User;
    var wallet = ViewBag.Wallet as EWallet.Core.Models.Wallet;
    var recipients = ViewBag.Recipients as List<EWallet.Core.Models.User>;

    var rupiah = (CultureInfo)CultureInfo.GetCultureInfo("id-ID").Clone();
    rupiah.NumberFormat.CurrencySymbol = "Rp ";
}

@section Styles {
    <style>
        .transfer-page {
            max-width: 620px;
        }

        .page-header .eyebrow {
            color: #6366f1;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .page-header h1 {
            font-weight: 750;
            letter-spacing: -.04em;
        }

        .sender-card {
            position: relative;
            overflow: hidden;
            border: 0;
            border-radius: 1.25rem;
            color: white;
            background:
                radial-gradient(120% 140% at 100% 0%, rgba(99, 102, 241, .35) 0%, rgba(99, 102, 241, 0) 55%),
                linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            box-shadow: 0 12px 30px rgba(67, 56, 202, .16);
        }

        .sender-card::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -65px;
            top: -85px;
            border: 1px solid rgba(255, 255, 255, .15);
            border-radius: 50%;
            box-shadow: 0 0 0 25px rgba(255, 255, 255, .04),
                0 0 0 50px rgba(255, 255, 255, .03);
        }

        .sender-card .label {
            color: rgba(255, 255, 255, .7);
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .sender-card .balance {
            font-size: clamp(1.4rem, 5vw, 1.8rem);
            font-weight: 750;
            letter-spacing: -.035em;
            font-variant-numeric: tabular-nums;
        }

        .sender-card .wallet-number {
            color: rgba(255, 255, 255, .85);
            font-family: ui-monospace, monospace;
            font-size: .85rem;
            letter-spacing: .07em;
        }

        .form-card {
            border: 1px solid #e5e7eb;
            border-radius: 1.25rem;
            box-shadow: 0 8px 30px rgba(15, 23, 42, .045);
        }

        .form-card .form-label {
            color: #334155;
            font-size: .875rem;
            font-weight: 650;
        }

        .form-card .form-control,
        .form-card .form-select,
        .form-card .input-group-text {
            min-height: 48px;
            border-radius: .75rem;
            padding: .7rem .9rem;
        }

        .form-card .input-group-text {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
        }

        .form-card .input-group .form-control {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        .form-card .form-control:focus,
        .form-card .form-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 .2rem rgba(99, 102, 241, .12);
        }

        .form-card textarea.form-control {
            min-height: 100px;
        }

        .field-error {
            font-size: .8rem;
        }

        .validation-summary-valid {
            display: none;
        }

        .action-btn {
            min-height: 48px;
            border-radius: .75rem;
            padding: .7rem 1.2rem;
            font-weight: 650;
        }

        .form-hint {
            color: #64748b;
            font-size: .78rem;
        }

        .section-divider {
            border-top: 1px solid #eef0f3;
        }
    </style>
}

<div class="container transfer-page py-5">

    <header class="page-header mb-4">
        <p class="eyebrow mb-2">Wallet Services</p>
        <h1 class="h2 mb-2">Transfer Money</h1>
        <p class="text-muted mb-0">
            Send money securely to another wallet.
        </p>
    </header>

    <!-- Sender Information -->
    <section class="sender-card p-4 mb-4" aria-label="Sender information">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <div class="label mb-2">Sending from</div>
                <div class="fw-bold fs-5">@(user?.Name ?? "—")</div>
                <div class="wallet-number mt-1">
                    @(wallet?.WalletNumber ?? "—")
                </div>
            </div>

            <div class="text-end">
                <div class="label mb-2">Available balance</div>
                <div class="balance">
                    @(wallet is null ? "—" : wallet.Balance.ToString("C0", rupiah))
                </div>
            </div>
        </div>
    </section>

    <!-- Transfer Form -->
    <section class="card form-card">
        <div class="card-body p-4 p-md-4">

            <div class="mb-4">
                <h2 class="h5 fw-bold mb-1">Transfer Details</h2>
                <p class="text-muted small mb-0">
                    Enter the recipient and amount you want to send.
                </p>
            </div>

            <form asp-action="Transfer" method="post">
                <input type="hidden" asp-for="SenderUserId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <!-- Recipient -->
                <div class="mb-4">
                    <label asp-for="ReceiverUserId" class="form-label">
                        Recipient
                    </label>

                    <select asp-for="ReceiverUserId" class="form-select">
                        <option value="0">Choose recipient...</option>

                        @if (recipients is not null)
                        {
                            foreach (var recipient in recipients)
                            {
                                <option value="@recipient.Id">
                                    @recipient.Name (@recipient.Email)
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="ReceiverUserId" class="text-danger field-error"></span>
                </div>

                <!-- Amount -->
                <div class="mb-4">
                    <label asp-for="Amount" class="form-label">
                        Transfer Amount
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">Rp</span>

                        <input asp-for="Amount" type="number" step="1000" min="10000" inputmode="numeric"
                               class="form-control" placeholder="Enter amount" autocomplete="off" />
                    </div>

                    <div class="form-hint mt-2">Minimum transfer: @(10000.ToString("C0", rupiah))</div>

                    <span asp-validation-for="Amount" class="text-danger field-error"></span>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">
                        Description
                        <span class="text-muted fw-normal">(Optional)</span>
                    </label>

                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="What is this transfer for?"></textarea>

                    <span asp-validation-for="Description" class="text-danger field-error"></span>
                </div>

                <div class="section-divider pt-4">
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="submit" class="btn btn-primary action-btn flex-grow-1">
                            Transfer Now
                        </button>

                        <a asp-action="Dashboard" asp-route-userId="@Model.SenderUserId"
                           class="btn btn-outline-secondary action-btn">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <footer class="mt-4">
        <a asp-action="Dashboard" asp-route-userId="@Model.SenderUserId"
           class="text-decoration-none text-secondary small">
            &larr; Back to Wallet Dashboard
        </a>
    </footer>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const amountInput = document.getElementById("Amount");

            if (!amountInput) return;

            // Remove the default zero when the form is first displayed.
            if (amountInput.value === "0") {
                amountInput.value = "";
            }

            // Remove unnecessary leading zeros while typing.
            amountInput.addEventListener("input", function () {
                this.value = this.value.replace(/^0+(?=\d)/, "");
            });
        });
    </script>
}
