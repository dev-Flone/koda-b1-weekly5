@model EWallet.Mvc.ViewModel.TopUpViewModel;

@{
    ViewData["Title"] = "Top Up";
}

<div class="container  mt-5">
    <h2>Top Up Wallet</h2>

    <form asp-action="TopUp" method="post">
        <input type="hidden" asp-for="UserId">

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">Amount</label>

            <input asp-for="Amount" type="number" step="10000" class="form-control" placeholder="Enter amount">

            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>

            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description"></textarea>

            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Submit Top Up</button>

        <a asp-action="Dashboard" asp-route-userId="@Model.UserId" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}