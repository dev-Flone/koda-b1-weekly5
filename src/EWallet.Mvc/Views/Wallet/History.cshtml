@using System.Globalization
@model EWallet.Mvc.ViewModel.TransactionHistoryViewModel

@{
    ViewData["Title"] = "Transaction History";
    var rupiah = (CultureInfo)CultureInfo.GetCultureInfo("id-ID").Clone();
    rupiah.NumberFormat.CurrencySymbol = "Rp. ";

    bool IsActive(string name) =>
        string.Equals(Model.Filter, name, StringComparison.OrdinalIgnoreCase);

    var filters = new[] { "All", "Income", "Expense" };
}

@section Styles {
    <style>
        .history-page {
            max-width: 820px;
        }

        .history-card {
            border: 1px solid #e5e7eb;
            border-radius: 1rem;
            box-shadow: 0 1px 2px rgba(15, 23, 42, .04), 0 8px 24px rgba(15, 23, 42, .04);
            overflow: hidden;
        }

        .filter-pills .btn {
            border-radius: 999px;
            padding: .4rem 1rem;
            font-size: .875rem;
            font-weight: 600;
        }

        .history-table thead th {
            font-size: .75rem;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #64748b;
            font-weight: 600;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            padding: .85rem 1.25rem;
            white-space: nowrap;
        }

        .history-table tbody td {
            padding: 1rem 1.25rem;
            border-color: #f1f5f9;
        }

        .history-table .amount {
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-soft {
            font-weight: 600;
            padding: .4em .7em;
            border-radius: 999px;
        }

        .badge-soft-income {
            background: #dcfce7;
            color: #166534;
        }

        .badge-soft-expense {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty-state {
            padding: 3.5rem 1rem;
        }
    </style>
}

<div class="container history-page py-5">

    <header class="mb-4">
        <p class="text-uppercase text-muted small fw-semibold mb-1">Wallet</p>
        <h1 class="h3 fw-bold mb-1">Transaction History</h1>
        <p class="text-muted mb-0">A record of all money coming in and going out.</p>
    </header>

    <nav class="filter-pills d-flex flex-wrap gap-2 mb-3" aria-label="Filter transactions">
        @foreach (var f in filters)
        {
            <a asp-action="History" asp-route-userId="@Model.UserId" asp-route-filter="@f"
               class="btn @(IsActive(f) ? "btn-primary" : "btn-outline-secondary")"
               aria-current="@(IsActive(f) ? "page" : null)">@f</a>
        }
    </nav>

    <section class="card history-card" aria-label="Transactions">
        @if (Model.Transactions.Count == 0)
        {
            <div class="empty-state text-center">
                <h2 class="h6 fw-semibold mb-1">No transactions found</h2>
                <p class="text-muted small mb-0">
                    @(IsActive("All") ? "Your transactions will appear here." : "Nothing matches this filter yet.")
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 history-table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Type</th>
                            <th scope="col">Description</th>
                            <th scope="col" class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Transactions)
                        {
                            <tr>
                                <td class="text-nowrap text-muted">
                                    @item.Transactions.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    @if (item.IsIncome)
                                    {
                                        <span class="badge badge-soft badge-soft-income">Income</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft badge-soft-expense">Expense</span>
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Transactions.Description) ? "—" :
                            item.Transactions.Description)
                                </td>
                                <td class="amount text-end @(item.IsIncome ? "text-success" : "text-danger")">
                                    @(item.IsIncome ? "+" : "−")@item.Transactions.Amount.ToString("C2", rupiah)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <footer class="mt-4">
        <a asp-action="Dashboard" asp-route-userId="@Model.UserId" class="link-secondary text-decoration-none">
            &larr; Back to Dashboard
        </a>
    </footer>
</div>
