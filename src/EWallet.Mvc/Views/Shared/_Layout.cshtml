<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EWallet.Mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EWallet.Mvc.styles.css" asp-append-version="true" />

    <style>
            :root {
                --app-accent: #6366f1;
                --app-accent-hover: #4f46e5;
                --app-ink: #0f172a;
                --app-muted: #64748b;
                --app-border: #e5e7eb;
                --app-bg: #f8fafc;
            }

            html {
                position: static;
                min-height: 0;
            }

            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin-bottom: 0;
                background: var(--app-bg);
                color: var(--app-ink);
                font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            body>.app-content {
                flex: 1 0 auto;
            }

            /* Primary buttons follow the accent color across every page */
            .btn-primary {
                --bs-btn-bg: var(--app-accent);
                --bs-btn-border-color: var(--app-accent);
                --bs-btn-hover-bg: var(--app-accent-hover);
                --bs-btn-hover-border-color: var(--app-accent-hover);
                --bs-btn-active-bg: var(--app-accent-hover);
                --bs-btn-active-border-color: var(--app-accent-hover);
                --bs-btn-disabled-bg: var(--app-accent);
                --bs-btn-disabled-border-color: var(--app-accent);
                --bs-btn-focus-shadow-rgb: 99, 102, 241;
            }

            .btn-outline-primary {
                --bs-btn-color: var(--app-accent);
                --bs-btn-border-color: var(--app-accent);
                --bs-btn-hover-bg: var(--app-accent);
                --bs-btn-hover-border-color: var(--app-accent);
                --bs-btn-active-bg: var(--app-accent);
                --bs-btn-active-border-color: var(--app-accent);
                --bs-btn-focus-shadow-rgb: 99, 102, 241;
            }

            a:focus-visible,
            .btn:focus-visible,
            .navbar-toggler:focus-visible {
                outline: 2px solid var(--app-accent);
                outline-offset: 2px;
            }

            /* Navbar */
            .app-nav {
                background: rgba(255, 255, 255, .9);
                backdrop-filter: saturate(180%) blur(8px);
                border-bottom: 1px solid var(--app-border);
                padding-block: .65rem;
            }

            .app-brand {
                display: inline-flex;
                align-items: center;
                gap: .6rem;
                font-weight: 700;
                letter-spacing: -.01em;
                color: var(--app-ink);
            }

            .app-brand:hover {
                color: var(--app-ink);
            }

            .app-brand .mark {
                display: inline-grid;
                place-items: center;
                width: 1.85rem;
                height: 1.85rem;
                border-radius: .55rem;
                background: var(--app-accent);
                color: #fff;
                font-size: .95rem;
                font-weight: 700;
            }

            .app-brand .suffix {
                color: var(--app-muted);
                font-weight: 500;
            }

            .app-nav .nav-link {
                color: var(--app-muted);
                font-weight: 500;
                font-size: .9375rem;
                border-radius: .5rem;
                padding: .45rem .8rem;
            }

            .app-nav .nav-link:hover {
                color: var(--app-ink);
                background: #f1f5f9;
            }

            .app-nav .navbar-toggler {
                border: 1px solid var(--app-border);
                border-radius: .6rem;
                padding: .35rem .6rem;
            }

            .app-nav .navbar-toggler:focus {
                box-shadow: none;
            }

            /* Footer */
            .app-footer {
                position: static;
                width: 100%;
                white-space: normal;
                line-height: 1.5;
                padding-block: 1.5rem;
                margin-top: 2rem;
                border-top: 1px solid var(--app-border);
                background: #fff;
                font-size: .875rem;
                color: var(--app-muted);
            }

            .app-footer a {
                color: var(--app-muted);
                text-decoration: none;
            }

            .app-footer a:hover {
                color: var(--app-ink);
                text-decoration: underline;
            }

            .skip-link {
                position: absolute;
                left: -999px;
                top: .5rem;
                z-index: 2000;
                background: #fff;
                border: 1px solid var(--app-border);
                border-radius: .5rem;
                padding: .5rem .9rem;
            }

            .skip-link:focus {
                left: .75rem;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header>
        <nav class="navbar navbar-expand-sm app-nav sticky-top">
            <div class="container">
                <a class="navbar-brand app-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="mark" aria-hidden="true">E</span>
                    <span>EWallet<span class="suffix">.Mvc</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-sm-3 gap-sm-1 pt-3 pt-sm-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-content">
        <main id="main" role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-1">
            <span>&copy; 2026 EWallet.Mvc</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
